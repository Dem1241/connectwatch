# records assets/demo.gif from the --demo cluster: vhs assets/demo.tape
Output assets/demo.gif

Set Shell bash
Set FontSize 16
Set Width 1400
Set Height 760
Set Padding 20
Set Theme "Catppuccin Mocha"

Type "connectwatch --demo"
Sleep 500ms
Enter
Sleep 3s

Tab
Sleep 2.5s
Tab
Sleep 2s
Tab
Sleep 1.5s

Down
Sleep 2s
Type "R"
Sleep 1.5s
Type "y"
Sleep 3s

Up
Sleep 1.5s
Type "R"
Sleep 1s
Type "y"
Sleep 4s
Sleep 10s

Type "/sink"
Sleep 2.5s
Escape
Sleep 2s

Type "q"
